# Optional: public GitHub metadata gets a higher rate limit with a server-only token.
GITHUB_TOKEN=
# Set when the Medium profile is ready, e.g. https://medium.com/@yourname
MEDIUM_PROFILE_URL=
# Hidden terminal Q&A. Server-only: never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Cheapest text model as checked 2026-11-03; retires 2026-12-11. Change before then.
OPENAI_MODEL=gpt-5-nano
# Owner-only upload script credential. Never expose this to browser code.
BLOB_READ_WRITE_TOKEN=
# Public store origin. Missing resume.pdf falls back to the existing resume link.
# Example: https://your-store.public.blob.vercel-storage.com
PORTFOLIO_BLOB_URL=
